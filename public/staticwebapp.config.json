{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/brands/*", "/*.{js,css,ico,png,jpg,jpeg,svg,webp,woff,woff2,json,map}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    }
  ]
}
